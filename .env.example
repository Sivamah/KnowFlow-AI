# ─────────────────────────────────────────────────────────────────────────────
#  Environment Configuration — KnowFlow AI: Document Research Assistant
#  Copy this file to .env and configure your local credentials.
#  WARNING: Never commit .env or live API keys to source control!
# ─────────────────────────────────────────────────────────────────────────────

# Groq LLM API Key (Required for answer generation)
# Obtain a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Default Groq Model (defaults to openai/gpt-oss-120b or llama-3.3-70b-versatile)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: ChromaDB Persistence Directory
# CHROMA_PERSIST_DIR=./data/chroma_db

# Optional: ngrok Auth Token (only needed when running on Google Colab / cloud tunnels)
# NGROK_TOKEN=your_ngrok_token_here
